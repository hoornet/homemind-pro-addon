#!/command/with-contenv bash
# Retry the Home Assistant Core restart that updated integration files need in
# order to actually be loaded.
#
# install-integration asks for that restart the moment it copies new files. This
# service runs at the end of the startup chain — after the server is up and
# discovery has run — and tries again if that first attempt did not land.
#
# Note on why this exists, because the first explanation was wrong: 2.4.3 added
# these retries on the theory that Supervisor was merely busy finishing the
# add-on update and would accept a later request. The retry logging it also
# added then showed the truth — "403: Forbidden", every attempt. The old
# endpoint (Supervisor's /core/restart) needs `hassio_role: manager`, which this
# add-on does not request, so no amount of retrying could ever have worked.
# 2.4.4 moved the request to the Home Assistant Core API proxy, which our
# `homeassistant_api: true` permission does grant. The retries are kept because
# they are still useful when Home Assistant is briefly unavailable — but they
# are no longer the fix.
#
# Bounded either way: if the restart never lands, the add-on stays fully
# functional and the log tells the user to restart Home Assistant themselves.

FLAG="/data/.ha_restart_needed"
ACK="/config/nives/.api_token.ack"
MANIFEST="/config/custom_components/nives/manifest.json"

[ -f "$FLAG" ] || exit 0

# The integration rewrites its token receipt every time it sets up, so a receipt
# newer than the integration files on disk means Home Assistant has already
# loaded them — the user restarted it themselves before we got here. Clear the
# flag rather than restarting them a second time for no reason.
if [ -f "$ACK" ] && [ -f "$MANIFEST" ] && [ "$ACK" -nt "$MANIFEST" ]; then
    rm -f "$FLAG"
    echo "[ha-restart] Home Assistant has already loaded the updated integration"
    exit 0
fi

echo "[ha-restart] Home Assistant still needs a restart to load the updated Nives integration"

for delay in 10 20 30 45; do
    sleep "$delay"

    if OUT=$(/usr/local/bin/restart-ha-core.sh 2>&1); then
        rm -f "$FLAG"
        echo "$OUT" | sed 's/^/[ha-restart] /'
        exit 0
    fi
    # Log what was actually said. The single most useful thing the original
    # version did NOT do was record the reason — that omission cost us a whole
    # release built on the wrong diagnosis.
    echo "$OUT" | sed 's/^/[ha-restart] /'
done

# The flag stays set, so the next add-on start tries again.
echo "[ha-restart] WARNING: could not restart Home Assistant Core automatically."
echo "[ha-restart]          The updated Nives integration is on disk but Home"
echo "[ha-restart]          Assistant is still running the previous version."
echo "[ha-restart]          Restart Home Assistant (Settings → System → Restart)."
echo "[ha-restart]          Nives keeps working in the meantime."
exit 0
