#!/command/with-contenv bash
# Tell the user when Home Assistant needs a restart to load updated Nives
# integration files — and only tell them. The add-on never restarts Home
# Assistant on its own.
#
# History: 2.4.2–2.4.10 restarted HA Core automatically after updating the
# integration files. Issue #50 showed why that had to go, twice over. The
# restart request goes through the Supervisor's Core API proxy, and Core goes
# down before it can answer — so the proxy returns 504 and a restart that HAD
# been accepted was logged as refused. The retry loop then fired again once
# Core was back up, restarting it a second time. From the user's side: Home
# Assistant rebooting repeatedly, unannounced, right after installing Nives.
# That reads as a crash, and the report said exactly that. An add-on asking
# for a restart is ordinary (HACS does the same); an add-on rebooting the
# house unasked is not.
#
# install-integration writes the flag (containing "install" or "update") when
# it copies new files. This service runs at the end of the startup chain and
# turns the flag into a persistent notification in Home Assistant. The
# integration rewrites its token receipt on every setup, so a receipt newer
# than the integration files on disk means Home Assistant has loaded them —
# then the flag is cleared and the notification dismissed. Persistent
# notifications don't survive a Core restart anyway, so the reminder
# disappears the moment the user acts on it.

FLAG="/data/.ha_restart_needed"
ACK="/config/nives/.api_token.ack"
MANIFEST="/config/custom_components/nives/manifest.json"
NOTIFY_ID="nives_restart_needed"

[ -f "$FLAG" ] || exit 0

TOKEN="${SUPERVISOR_TOKEN:-}"
if [ -z "$TOKEN" ] && [ -f /var/run/s6/container_environment/SUPERVISOR_TOKEN ]; then
    TOKEN=$(cat /var/run/s6/container_environment/SUPERVISOR_TOKEN)
fi

notify() {
    # $1 = service (create|dismiss), $2 = JSON payload
    [ -n "$TOKEN" ] || return 1
    curl -s -o /dev/null --max-time 10 -X POST \
        -H "Authorization: Bearer ${TOKEN}" \
        -H "Content-Type: application/json" \
        -d "$2" \
        "http://supervisor/core/api/services/persistent_notification/$1"
}

if [ -f "$ACK" ] && [ -f "$MANIFEST" ] && [ "$ACK" -nt "$MANIFEST" ]; then
    rm -f "$FLAG"
    notify dismiss "{\"notification_id\": \"${NOTIFY_ID}\"}"
    echo "[ha-restart] Home Assistant has already loaded the updated integration"
    exit 0
fi

MODE=$(cat "$FLAG" 2>/dev/null)
if [ "$MODE" = "install" ]; then
    MESSAGE="Nives is installed! Restart Home Assistant once (Settings → System → Restart) to activate the integration."
else
    MESSAGE="Nives was updated. Restart Home Assistant at a moment that suits you (Settings → System → Restart) to finish the update. Nives keeps working in the meantime."
fi

if notify create "{\"notification_id\": \"${NOTIFY_ID}\", \"title\": \"Nives\", \"message\": \"${MESSAGE}\"}"; then
    echo "[ha-restart] Home Assistant needs a restart to load the updated Nives integration."
    echo "[ha-restart] A notification has been posted in Home Assistant — restart whenever"
    echo "[ha-restart] it suits you. Nives keeps working in the meantime."
else
    echo "[ha-restart] Home Assistant needs a restart to load the updated Nives integration."
    echo "[ha-restart] Restart it whenever it suits you (Settings → System → Restart)."
    echo "[ha-restart] Nives keeps working in the meantime."
fi

# The flag stays set so the reminder is re-posted on the next add-on start if
# Home Assistant still hasn't been restarted by then.
exit 0
