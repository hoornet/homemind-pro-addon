#!/command/with-contenv bash
# Auto-install the Nives HA integration (custom component)
# so users don't need HACS or manual file copying.

SOURCE="/opt/nives"
TARGET="/config/custom_components/nives"

if [ ! -d /config ]; then
    echo "[integration] /config not mounted — skipping integration install"
    exit 0
fi

# Check if files need updating by comparing manifest versions
NEEDS_UPDATE=false
FRESH_INSTALL=false
if [ ! -d "$TARGET" ]; then
    NEEDS_UPDATE=true
    FRESH_INSTALL=true
    echo "[integration] Installing Nives integration..."
elif [ -f "$SOURCE/manifest.json" ] && [ -f "$TARGET/manifest.json" ]; then
    SOURCE_VER=$(jq -r '.version' "$SOURCE/manifest.json" 2>/dev/null || echo "")
    TARGET_VER=$(jq -r '.version' "$TARGET/manifest.json" 2>/dev/null || echo "")
    if [ "$SOURCE_VER" != "$TARGET_VER" ]; then
        NEEDS_UPDATE=true
        echo "[integration] Updating Nives integration (${TARGET_VER} → ${SOURCE_VER})..."
    fi
fi

if [ "$NEEDS_UPDATE" = "true" ]; then
    mkdir -p "$TARGET"
    cp -f "$SOURCE"/*.py "$TARGET/"
    cp -f "$SOURCE"/*.json "$TARGET/"
    # Brand images: HA 2026.3+ serves icon/logo from the integration's brand/
    # folder (local images take priority over the brands CDN). Replace wholesale
    # so stale assets don't linger across updates.
    if [ -d "$SOURCE/brand" ]; then
        rm -rf "$TARGET/brand"
        cp -rf "$SOURCE/brand" "$TARGET/"
    fi
    # Translations: custom integrations load UI text (config flow, repair
    # issues) from translations/<lang>.json at runtime — strings.json alone
    # is only the dev-time source. Replace wholesale, same as brand/.
    if [ -d "$SOURCE/translations" ]; then
        rm -rf "$TARGET/translations"
        cp -rf "$SOURCE/translations" "$TARGET/"
    fi
    echo "[integration] Nives integration installed at $TARGET"

    # Home Assistant has to be restarted before it will load the files we just
    # wrote — but the add-on does NOT restart it itself. It used to (2.4.2–
    # 2.4.10), and issue #50 showed how that plays out: an unannounced reboot,
    # sometimes doubled by the retry logic, that users reasonably read as Home
    # Assistant crashing. Instead the flag makes the ha-restart service post a
    # persistent notification once the add-on is up, and the user restarts at
    # a moment of their choosing. Until then Home Assistant keeps running the
    # previous integration version, which the server stays compatible with;
    # the token-receipt auth handshake simply waits for that restart too (no
    # receipt → auth stays off, nothing breaks).
    if [ "$FRESH_INSTALL" = "true" ]; then
        echo "install" > /data/.ha_restart_needed
    else
        echo "update" > /data/.ha_restart_needed
    fi
    echo "[integration] Home Assistant needs one restart to load the integration —"
    echo "[integration] a notification will be posted in Home Assistant."
else
    echo "[integration] Nives integration is up to date"
fi
