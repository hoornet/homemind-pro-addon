#!/command/with-contenv bash
# Auto-install the Nives HA integration (custom component)
# so users don't need HACS or manual file copying.

SOURCE="/opt/nives"
TARGET="/config/custom_components/nives"

if [ ! -d /config ]; then
    echo "[integration] /config not mounted — skipping integration install"
    exit 0
fi

# Check if files need updating by comparing manifest versions
NEEDS_UPDATE=false
if [ ! -d "$TARGET" ]; then
    NEEDS_UPDATE=true
    echo "[integration] Installing Nives integration..."
elif [ -f "$SOURCE/manifest.json" ] && [ -f "$TARGET/manifest.json" ]; then
    SOURCE_VER=$(jq -r '.version' "$SOURCE/manifest.json" 2>/dev/null || echo "")
    TARGET_VER=$(jq -r '.version' "$TARGET/manifest.json" 2>/dev/null || echo "")
    if [ "$SOURCE_VER" != "$TARGET_VER" ]; then
        NEEDS_UPDATE=true
        echo "[integration] Updating Nives integration (${TARGET_VER} → ${SOURCE_VER})..."
    fi
fi

if [ "$NEEDS_UPDATE" = "true" ]; then
    mkdir -p "$TARGET"
    cp -f "$SOURCE"/*.py "$TARGET/"
    cp -f "$SOURCE"/*.json "$TARGET/"
    # Brand images: HA 2026.3+ serves icon/logo from the integration's brand/
    # folder (local images take priority over the brands CDN). Replace wholesale
    # so stale assets don't linger across updates.
    if [ -d "$SOURCE/brand" ]; then
        rm -rf "$TARGET/brand"
        cp -rf "$SOURCE/brand" "$TARGET/"
    fi
    echo "[integration] Nives integration installed at $TARGET"

    # Home Assistant has to be restarted before it will load the files we just
    # wrote. Record that as a flag first: the attempt below is only the fast
    # path, and it is the one that fails during a Supervisor-driven add-on
    # update. The flag is what lets the ha-restart service retry later, once
    # Supervisor is no longer busy with that update.
    touch /data/.ha_restart_needed

    # This matters more since 2.4.2: the integration only learns to read the API
    # token once HA Core is running the new files. If no restart ever happens,
    # the add-on notices (no token receipt) and simply leaves auth switched off,
    # so nothing breaks — but the update is incomplete until HA reloads.
    #
    # --max-time matters: nives-server waits on this oneshot, so a hung request
    # here would stop the server ever starting.
    if [ -n "$SUPERVISOR_TOKEN" ]; then
        echo "[integration] Restarting HA Core to load updated integration..."
        CODE=$(curl -s -o /tmp/integration-restart-resp -w '%{http_code}' --max-time 30 -X POST \
            -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
            http://supervisor/core/restart 2>/dev/null)
        case "$CODE" in
            2*)
                rm -f /data/.ha_restart_needed
                echo "[integration] HA Core restart triggered"
                ;;
            *)
                echo "[integration] HA Core restart request failed (HTTP ${CODE:-none}): $(head -c 200 /tmp/integration-restart-resp 2>/dev/null)"
                echo "[integration] Will retry once the add-on has finished starting."
                ;;
        esac
        rm -f /tmp/integration-restart-resp
    else
        echo "[integration] No SUPERVISOR_TOKEN — skipping HA Core restart"
    fi
else
    echo "[integration] Nives integration is up to date"
fi
