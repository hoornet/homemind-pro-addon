#!/command/with-contenv bash
# Monitors Shodh RSS memory usage every 4 hours.
# If RSS exceeds 512MB, gracefully restarts Shodh.
# Mitigates memory leak: https://github.com/varun29ankuS/shodh-memory/issues/90

MAX_RSS_KB=524288  # 512MB

# Match the binary as it is actually launched: /usr/local/bin/shodh server ...
# The old pattern was "shodh-memory", which appears nowhere in that command line,
# so the watchdog matched nothing and silently did nothing for every release it
# shipped in. Keep this in sync with s6-rc.d/shodh/run.
SHODH_PATTERN='/usr/local/bin/shodh'

while true; do
    sleep 14400  # 4 hours

    SHODH_PID=$(pgrep -f "$SHODH_PATTERN" | head -1)
    if [ -z "$SHODH_PID" ]; then
        echo "[watchdog] No process matching '${SHODH_PATTERN}' — cannot check Shodh RSS"
        continue
    fi

    RSS_KB=$(awk '/VmRSS/ {print $2}' "/proc/${SHODH_PID}/status" 2>/dev/null || echo "0")

    if [ "$RSS_KB" -gt "$MAX_RSS_KB" ]; then
        echo "[watchdog] Shodh RSS is ${RSS_KB}KB (>${MAX_RSS_KB}KB limit), restarting..."
        kill -TERM "$SHODH_PID"
        # s6 will restart Shodh automatically via the longrun service
    else
        echo "[watchdog] Shodh RSS is ${RSS_KB}KB — healthy"
    fi
done
