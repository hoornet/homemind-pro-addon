#!/command/with-contenv bash
# Send discovery message to HA Supervisor so the companion integration
# auto-configures without manual URL entry.

# Only run if we have a Supervisor token (i.e., running inside HA)
SUPERVISOR_TOKEN="${SUPERVISOR_TOKEN:-}"
if [ -z "$SUPERVISOR_TOKEN" ] && [ -f /var/run/s6/container_environment/SUPERVISOR_TOKEN ]; then
    SUPERVISOR_TOKEN=$(cat /var/run/s6/container_environment/SUPERVISOR_TOKEN)
fi

if [ -z "$SUPERVISOR_TOKEN" ]; then
    echo "[discovery] No SUPERVISOR_TOKEN — not running inside HA, skipping discovery"
    exit 0
fi

# Wait for the server to be healthy
echo "[discovery] Waiting for Nives server..."
for i in $(seq 1 30); do
    if curl -sf http://127.0.0.1:3100/api/health > /dev/null 2>&1; then
        break
    fi
    if [ "$i" -eq 30 ]; then
        echo "[discovery] Server did not become healthy, skipping discovery"
        exit 0
    fi
    sleep 2
done

# Get our hostname (used by HA to reach this add-on on the internal network)
ADDON_HOST=$(hostname)

# Ship the API token in the discovery payload so a brand-new install is
# authenticated the moment the user confirms the discovered add-on.
#
# This only helps NEW entries. Supervisor deduplicates discovery messages, so an
# install that already exists never sees this payload again — those pick the
# token up from /config/nives/.api_token instead, which the integration re-reads
# on every setup. Don't rely on this path for upgrades; 2.4.0 did and broke
# Assist for everyone already installed.
API_TOKEN=$(cat /data/.api_token 2>/dev/null || echo "")
if [ -z "$API_TOKEN" ]; then
    echo "[discovery] WARNING: no /data/.api_token — the integration will be sent no token"
fi

echo "[discovery] Sending discovery to Supervisor (host=${ADDON_HOST}, port=3100)..."
RESPONSE=$(curl -s -X POST \
    -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
    -H "Content-Type: application/json" \
    -d "{\"service\":\"nives\",\"config\":{\"host\":\"${ADDON_HOST}\",\"port\":3100,\"api_token\":\"${API_TOKEN}\"}}" \
    http://supervisor/discovery 2>&1) || true

# Never log the token itself.
echo "[discovery] Supervisor response: ${RESPONSE:-no response}"
